--- !u!114 &86642301
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 86642299}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d3f574c6393efcf48b6e52bcc5143049, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  DialogueLines:
  - "( \uC5EC\uAE30\uB294 \uC6B0\uB9AC \uC9D1\uC774\uC796\uC544..? \uB300\uCCB4 \uC5B4\uB5BB\uAC8C
    \uB41C \uC77C\uC774\uC9C0..? )"
  - "[\uC544\uBC84\uC9C0]\n\"...\uC131\uC801\uD45C \uBD24\uB2E4. (\uD55C\uC228) \uC774\uAC8C
    \uC815\uB9D0 \uCD5C\uC120\uC774\uC5C8\uB2C8?\""
  - "\"\uC5B4\uB9B4 \uB54C\uBD80\uD130 \uC54C\uC544\uC11C \uC798\uD558\uAE38\uB798
    \uBBFF\uACE0 \uB9E1\uACBC\uB354\uB2C8... \uC694\uC998 \uC815\uC2E0\uC774 \uC5B4\uB514
    \uD314\uB824 \uC788\uB294 \uAC74\uC9C0 \uBAA8\uB974\uACA0\uAD6C\uB098.\""
  - "\"\uACE0\uB4F1\uD559\uAD50 \uC131\uC801\uC774 \uB300\uD559\uC744 \uACB0\uC815\uD558\uACE0,
    \uB300\uD559\uC774 \uC778\uC0DD\uC744 \uACB0\uC815\uD55C\uB2E4\uACE0... \uADC0\uC5D0
    \uB531\uC9C0\uAC00 \uC549\uB3C4\uB85D \uB9D0\uD588\uC796\uC544. \uADF8\uB7F0\uB370
    \uC774\uAC8C \uBB50\uB2C8?\""
  - "[\uB098]\n( ...\uC544\uB2C8\uC5D0\uC694. \uC815\uB9D0 \uC8FD\uC744 \uB9CC\uD07C
    \uB178\uB825\uD588\uC5B4\uC694. \uC7A0\uB3C4 \uC904\uC5EC\uAC00\uBA74\uC11C \uD588\uB2E4\uACE0
    \uB9D0\uD558\uACE0 \uC2F6\uC740\uB370... )"
  - "( \uBAA9\uAD6C\uBA4D\uC774 \uD131 \uB9C9\uD78C \uAC83\uCC98\uB7FC, \uC544\uBB34\uB7F0
    \uBAA9\uC18C\uB9AC\uB3C4 \uB098\uC624\uC9C8 \uC54A\uB294\uB2E4. \uC2E4\uB9DD\uD55C
    \uC800 \uB208\uBE5B\uC744 \uB9C8\uC8FC\uD558\uB294 \uAC8C... \uB108\uBB34 \uBB34\uC11C\uC6CC.
    )"
  - "[\uC544\uBC84\uC9C0]\n\"\uB2E4\uC74C \uC2DC\uD5D8\uC740 \uAE30\uB300\uD558\uB9C8.
    \uB108\uB77C\uBA74 \uAE08\uBC29 \uC81C\uC790\uB9AC \uCC3E\uC744 \uC218 \uC788\uC796\uC544.
    \uC6B0\uB9AC \uC544\uB4E4 \uBBFF\uB294\uB2E4.\""
  - "[\uB098]\n\"...\uB124. \uB2E4\uC74C\uC5D4... \uB354 \uC798\uD560\uAC8C\uC694.\""
  - "( '\uBBFF\uB294\uB2E4'\uB294 \uADF8 \uB9D0\uC774... \uACA9\uB824\uAC00 \uC544\uB2C8\uB77C
    \uC871\uC1C4\uCC98\uB7FC \uB290\uAEF4\uC84C\uB2E4. )"
  - "( \uAC00\uC2B4 \uD55C\uAD6C\uC11D\uC774 \uC9D3\uB20C\uB9AC\uB294 \uAE30\uBD84\uC774\uC5C8\uC9C0\uB9CC,
    \uB098\uB294 \uADF8\uC800 \uAD1C\uCC2E\uC740 \uCC99 \uC6C3\uC5B4 \uB118\uAE30\uB294
    \uBC29\uBC95\uBC16\uC5D0 \uBAB0\uB790\uB2E4. )"
  - "( \uADF8\uB54C\uBD80\uD130\uC600\uC744\uAE4C... \uB0B4 \uC548\uC758 \uBB34\uC5B8\uAC00\uAC00
    \uC870\uAE08\uC529 \uACEA\uC544\uAC00\uAE30 \uC2DC\uC791\uD588\uB358 \uAC74.
    )"
  DialogueDurations:
  - 4
  - 3
  - 5
  - 5
  - 4
  - 5
  - 4
  - 3
  - 4
  - 5
  - 3
  TeleportLocation: {fileID: 1300741975}
  DarkIntensity: 0.7
